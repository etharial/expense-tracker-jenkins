pipeline {
    agent any

    parameters {
        string(
            name: 'MAIN_BRANCH_JOB',
            defaultValue: 'expense-tracker-jenkins/main',
            description: 'Jenkins multibranch job path ending in /main'
        )
        string(
            name: 'SOURCE_BUILD_NUMBER',
            defaultValue: '',
            description: 'Successful main-branch CI build number to deploy'
        )
        string(
            name: 'DEPLOY_PORT',
            defaultValue: '8080',
            description: 'Host port that serves the application'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Validate selection') {
            steps {
                script {
                    if (!(params.MAIN_BRANCH_JOB ==~ /.+\/main/)) {
                        error 'MAIN_BRANCH_JOB must identify a multibranch job ending in /main.'
                    }
                    if (!(params.SOURCE_BUILD_NUMBER ==~ /[1-9][0-9]*/)) {
                        error 'SOURCE_BUILD_NUMBER must be a positive build number.'
                    }
                    if (!(params.DEPLOY_PORT ==~ /[0-9]{1,5}/)
                        || params.DEPLOY_PORT.toInteger() < 1
                        || params.DEPLOY_PORT.toInteger() > 65535) {
                        error 'DEPLOY_PORT must be between 1 and 65535.'
                    }
                }
            }
        }

        stage('Retrieve accepted main artifact') {
            steps {
                copyArtifacts(
                    projectName: params.MAIN_BRANCH_JOB,
                    selector: specific(params.SOURCE_BUILD_NUMBER),
                    filter: 'release-bundle.tar.gz',
                    target: 'artifact',
                    fingerprintArtifacts: true
                )
                sh 'mkdir -p deploy-context && tar -xzf artifact/release-bundle.tar.gz -C deploy-context'
                sh 'test -f deploy-context/Dockerfile && test -d deploy-context/dist'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    set -eu
                    image="expense-tracker:${SOURCE_BUILD_NUMBER}"
                    docker build -t "$image" deploy-context

                    if docker container inspect expense-tracker >/dev/null 2>&1; then
                        docker rm -f expense-tracker
                    fi

                    docker run -d \
                        --name expense-tracker \
                        --restart unless-stopped \
                        -p "${DEPLOY_PORT}:80" \
                        "$image"
                '''
            }
        }
    }
}
